    <script>
        (function() {
            // ================= 共享数据配置（JSONBin） =================
            const JSONBIN_BIN_ID = '你的BIN_ID';          // ← 替换
            const JSONBIN_MASTER_KEY = '你的MASTER_KEY';  // ← 替换
            const JSONBIN_BASE = 'https://api.jsonbin.io/v3/b/' + JSONBIN_BIN_ID;

            // ================= 文本链接转换工具 =================
            function linkify(text) {
                const urlRegex = /((https?:\/\/)[^\s]+)/g;
                return text.replace(urlRegex, function(url) {
                    return `<a href="${url}" target="_blank" rel="noopener noreferrer">${url}</a>`;
                });
            }

            // ================= 共享数据加载与导出 =================
            function collectAllData() {
                const out = {};
                Object.keys(localStorage).forEach(k => {
                    if (k.startsWith('amber_')) out[k] = localStorage.getItem(k);
                });
                return out;
            }

            async function loadSharedData(forceOverwrite = false) {
                try {
                    const resp = await fetch(JSONBIN_BASE + '/latest', {
                        headers: { 'X-Master-Key': JSONBIN_MASTER_KEY },
                        cache: 'no-store'
                    });
                    if (!resp.ok) return false;
                    const result = await resp.json();
                    const data = result.record || {};
                    let changed = false;
                    Object.entries(data).forEach(([k, v]) => {
                        if (v === null || v === undefined) return;
                        if (forceOverwrite) {
                            localStorage.setItem(k, v);
                            changed = true;
                        } else if (localStorage.getItem(k) === null) {
                            localStorage.setItem(k, v);
                            changed = true;
                        }
                    });
                    return changed;
                } catch (e) {
                    console.warn('JSONBin 加载失败', e);
                    return false;
                }
            }

            async function saveRemoteData() {
                try {
                    await fetch(JSONBIN_BASE, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Master-Key': JSONBIN_MASTER_KEY
                        },
                        body: JSON.stringify(collectAllData())
                    });
                } catch (e) {
                    console.warn('JSONBin 同步失败', e);
                }
            }
            window.saveRemoteData = saveRemoteData;

            function afterSave() {
                saveRemoteData();
            }

            // ================= 音乐 =================
            const bgMusic = document.getElementById('bgMusic');
            const musicPlayBtn = document.getElementById('musicPlayBtn');
            const musicIcon = document.getElementById('musicIcon');
            const musicEditHint = document.getElementById('musicEditHint');
            const musicConfigOverlay = document.getElementById('musicConfigOverlay');

            let isPlaying = false;

            function attemptPlay() {
                if (isPlaying) return;
                let playPromise = bgMusic.play();
                if (playPromise !== undefined) {
                    playPromise.then(_ => {
                        musicIcon.className = 'fas fa-pause';
                        isPlaying = true;
                    }).catch(error => { console.log("等待交互"); });
                }
            }

            document.addEventListener('click', function initPlay() {
                attemptPlay();
                document.removeEventListener('click', initPlay);
            }, { once: true });
            window.addEventListener('load', attemptPlay);

            musicPlayBtn.addEventListener('click', function() {
                if (isPlaying) {
                    bgMusic.pause();
                    musicIcon.className = 'fas fa-play';
                    isPlaying = false;
                } else {
                    attemptPlay();
                }
            });

            bgMusic.addEventListener('play', () => { musicIcon.className = 'fas fa-pause'; isPlaying = true; });
            bgMusic.addEventListener('pause', () => { musicIcon.className = 'fas fa-play'; isPlaying = false; });

            bgMusic.addEventListener('error', function() {
                const t = document.getElementById('musicTitleDisplay');
                if (t && !t.textContent.includes('⚠️')) {
                    t.textContent = t.textContent + ' ⚠️';
                    t.title = '该歌曲可能因版权原因无法外链播放，请更换一首';
                }
            });

            // ============ 网易云输入解析 ============
            function parseNeteaseInput(inputVal) {
                let id = null, title = null, artist = null;
                const tm = inputVal.match(/《(.+?)》/);
                if (tm) title = tm[1];
                const am = inputVal.match(/分享\s*(.+?)\s*的单曲/) || inputVal.match(/([\u4e00-\u9fa5A-Za-z0-9_·\-]+)的单曲/);
                if (am) artist = am[1];
                const trimmed = inputVal.trim();
                if (/^\d{4,}$/.test(trimmed)) id = trimmed;
                if (!id) {
                    const im = inputVal.match(/[?&]id=(\d+)/);
                    if (im) id = im[1];
                }
                if (!id) {
                    const pm = inputVal.match(/music\.163\.com(?:\/#)?\/(?:song|outchain\/[0-9a-zA-Z]+)\/(\d+)/);
                    if (pm) id = pm[1];
                }
                return { id: id, title: title, artist: artist };
            }

            async function resolveShortLink(shortUrl) {
                const fullUrl = /^https?:\/\//.test(shortUrl) ? shortUrl : ('https://' + shortUrl);
                const enc = encodeURIComponent(fullUrl);
                const proxies = [
                    'https://api.allorigins.win/raw?url=' + enc,
                    'https://api.codetabs.com/v1/proxy?quest=' + enc,
                    'https://r.jina.ai/' + fullUrl
                ];
                for (const proxyUrl of proxies) {
                    try {
                        const controller = new AbortController();
                        const timer = setTimeout(() => controller.abort(), 10000);
                        const resp = await fetch(proxyUrl, { redirect: 'follow', signal: controller.signal });
