                    const icon = document.createElement('div');
                    icon.className = 'accordion-icon';
                    icon.innerHTML = '<i class="fas fa-book-open"></i>';
                    header.appendChild(icon);

                    const title = document.createElement('div');
                    title.className = 'accordion-title';
                    title.setAttribute('contenteditable', 'false');
                    title.innerText = item.title;

                    const titleHint = document.createElement('i');
                    titleHint.className = 'fas fa-pen acc-hint-icon';
                    title.appendChild(titleHint);

                    title.addEventListener('blur', function() {
                        if (!document.body.classList.contains('edit-mode')) return;
                        let newData = getAccordionData();
                        const newTitle = this.innerText.trim();
                        if (newTitle) {
                            newData[index].title = newTitle;
                            saveAccordionData(newData);
                            renderAccordion();
                        }
                    });
                    header.appendChild(title);

                    const arrow = document.createElement('i');
                    arrow.className = 'fas fa-chevron-down accordion-arrow';
                    header.appendChild(arrow);

                    accItem.appendChild(header);

                    const body = document.createElement('div');
                    body.className = 'accordion-body';

                    const desc = document.createElement('div');
                    desc.className = 'accordion-desc';
                    desc.setAttribute('contenteditable', 'false');
                    desc.innerHTML = linkify(item.content);

                    const descHint = document.createElement('div');
                    descHint.className = 'acc-desc-hint';
                    descHint.innerHTML = '<i class="fas fa-pen"></i> 点击修改';
                    desc.appendChild(descHint);

                    desc.addEventListener('blur', function() {
                        if (!document.body.classList.contains('edit-mode')) return;
                        let newData = getAccordionData();
                        newData[index].content = this.innerHTML;
                        saveAccordionData(newData);
                    });
                    body.appendChild(desc);
                    accItem.appendChild(body);

                    container.appendChild(accItem);
                });
            }

            window.openAddAccordionModal = function() {
                if(!document.body.classList.contains('edit-mode')) return;
                document.getElementById('newAccTitle').value = '';
                document.getElementById('newAccContent').value = '';
                document.getElementById('addAccOverlay').classList.add('active');
            };

            window.saveNewAccordion = function() {
                const title = document.getElementById('newAccTitle').value.trim();
                const content = document.getElementById('newAccContent').value.trim();
                if (!title) { alert('请输入标题'); return; }

                let data = getAccordionData();
                data.push({ id: Date.now(), title: title, content: content || '暂无内容' });
                saveAccordionData(data);
                renderAccordion();

                document.getElementById('addAccOverlay').classList.remove('active');
            };

            // ================= 初始化加载与模式切换 =================
            function loadSavedData() {
                const nameEl = document.getElementById('editName');
                const nameSaved = localStorage.getItem('amber_name');
                if (nameSaved) {
                    nameEl.innerHTML = nameSaved + ' <i class="fas fa-certificate" style="color:var(--c-primary)"></i>';
                }

                const bioEl = document.getElementById('editBio');
                const bioSaved = localStorage.getItem('amber_bio');
                if (bioSaved) {
                    bioEl.innerHTML = bioSaved;
                }

                const signatureEl = document.getElementById('editSignature');
                const signatureSaved = localStorage.getItem('amber_signature');
                if (signatureSaved) {
                    signatureEl.innerText = signatureSaved;
                }

                const joinEl = document.getElementById('editJoinDate');
                const joinSaved = localStorage.getItem('amber_join');
                if (joinSaved) {
                    joinEl.innerHTML = joinSaved;
                }

                const savedFollowing = localStorage.getItem('amber_following');
                if (savedFollowing) {
                    document.getElementById('statFollowing').textContent = savedFollowing;
                }
                const savedFollowers = localStorage.getItem('amber_followers');
                if (savedFollowers) {
                    document.getElementById('statFollowers').textContent = savedFollowers;
                }

                const usernameSaved = localStorage.getItem('amber_username_sync');
                if (usernameSaved) {
                    document.getElementById('usernameDisplay').textContent = usernameSaved;
                    syncUsername(usernameSaved);
                } else {
                    const defaultName = document.getElementById('usernameDisplay').textContent;
                    syncUsername(defaultName);
                }

                const savedCover = localStorage.getItem('amber_cover_bg');
                if (savedCover) {
                    document.getElementById('profileCover').style.backgroundImage = `url(${savedCover})`;
                }

                const savedAvatar = localStorage.getItem('amber_main_avatar');
                if (savedAvatar) {
                    const mainAvImg = document.getElementById('mainAvatarImg');
                    mainAvImg.src = savedAvatar;
                    document.getElementById('mainAvatar').classList.add('has-img');
                }

                initAllFeeds();
                renderAccordion();
            }

            const modeToggle = document.getElementById('modeToggle');
            const modeBtns = modeToggle.querySelectorAll('.mode-btn');
            const body = document.body;
            const pwdOverlay = document.getElementById('pwdOverlay');
            const pwdInput = document.getElementById('pwdInput');
            const pwdError = document.getElementById('pwdError');

            function setMode(mode) {
                if (mode === 'edit') {
                    body.classList.add('edit-mode');
                    document.querySelectorAll('[contenteditable]').forEach(el => el.setAttribute('contenteditable', 'true'));
                    document.querySelectorAll('.feed-text').forEach(el => el.setAttribute('contenteditable', 'true'));
                    document.querySelectorAll('.accordion-title, .accordion-desc').forEach(el => el.setAttribute('contenteditable', 'true'));
                } else {
                    body.classList.remove('edit-mode');
                    document.querySelectorAll('[contenteditable]').forEach(el => el.setAttribute('contenteditable', 'false'));
                    document.querySelectorAll('.feed-text').forEach(el => el.setAttribute('contenteditable', 'false'));
                    document.querySelectorAll('.accordion-title, .accordion-desc').forEach(el => el.setAttribute('contenteditable', 'false'));
                }

                initAllFeeds();
                renderAccordion();

                modeBtns.forEach(btn => {
                    if (btn.dataset.mode === mode) btn.classList.add('active');
                    else btn.classList.remove('active');
                });
            }

            modeBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const targetMode = this.dataset.mode;
                    if (this.classList.contains('active')) return;

                    if (targetMode === 'edit' && !body.classList.contains('edit-mode')) {
                        pwdOverlay.classList.add('active');
                        pwdInput.value = '';
                        pwdError.classList.remove('show');
                        setTimeout(() => pwdInput.focus(), 100);
                    } else if (targetMode === 'preview') {
                        setMode('preview');
                    }
                });
            });

            document.getElementById('pwdConfirm').addEventListener('click', function() {
                if (pwdInput.value === SECRET_KEY) {
                    localStorage.setItem('amber_is_owner', '1');
                    setMode('edit');
                    pwdOverlay.classList.remove('active');
                } else {
                    pwdError.classList.add('show');
                    pwdInput.value = '';
                }
            });
            document.getElementById('pwdCancel').addEventListener('click', () => pwdOverlay.classList.remove('active'));
            pwdInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') document.getElementById('pwdConfirm').click(); });

            window.saveTextOnlyEdit = function() {
                const newText = document.getElementById('textEditArea').value;
                if (currentEditingPostId !== null && currentEditingIndex !== null) {
                    let feedsData = getFeedsData(currentEditingPostId);
                    if(feedsData && feedsData[currentEditingIndex]) {
                        feedsData[currentEditingIndex].text = newText;
                        if (!newText.trim()) {
                            feedsData[currentEditingIndex].type = 'img';
                        } else if (feedsData[currentEditingIndex].type === 'img' && newText.trim()) {
                            feedsData[currentEditingIndex].type = 'text-img';
                        }
                        saveFeedsData(currentEditingPostId, feedsData);
                        renderFeeds(currentEditingPostId, currentEditingPostId);
                    }
                }
                document.getElementById('textEditOverlay').classList.remove('active');
            };

            document.addEventListener('blur', function(e) {
                const target = e.target;
                if (target.hasAttribute('contenteditable') && target.getAttribute('contenteditable') === 'true') {

                    if (target.id === 'editUsername') {
                        const rawText = target.innerText.replace('@', '').trim();
                        if (rawText === '') return;
                        syncUsername(rawText);
                        target.innerHTML = `<i class="fas fa-at"></i> <span id="usernameDisplay">${rawText}</span>`;
                        initAllFeeds();
                        afterSave();
                        return;
                    }

                    if (target.id === 'editName') {
                        const pureText = target.innerText.replace(/<i class="fas fa-certificate".*?<\/i>/, '').trim();
                        localStorage.setItem('amber_name', pureText);
                        target.innerHTML = pureText + ' <i class="fas fa-certificate" style="color:var(--c-primary)"></i>';
                        initAllFeeds();  // 昵称修改后刷新动态，同步 feed-name
                        afterSave();
                        return;
                    }

                    if (target.id === 'editSignature') {
                        localStorage.setItem('amber_signature', target.innerText);
                        afterSave();
                        return;
                    }

                    const bioBox = target.closest('#editBio');
                    if (bioBox) {
                        localStorage.setItem('amber_bio', bioBox.innerHTML);
                        afterSave();
                        return;
                    }

                    const joinBox = target.closest('#editJoinDate');
                    if (joinBox) {
                        localStorage.setItem('amber_join', joinBox.innerHTML);
                        afterSave();
                        return;
                    }

                    if (target.id === 'statFollowing') {
                        localStorage.setItem('amber_following', target.innerText);
                        afterSave();
                        return;
                    }

                    if (target.id === 'statFollowers') {
                        localStorage.setItem('amber_followers', target.innerText);
                        afterSave();
                        return;
                    }

                    if (target.classList.contains('feed-text')) {
                        const postId = target.dataset.postid;
                        const index = parseInt(target.dataset.index);
                        let feedsData = getFeedsData(postId);
                        if(feedsData && feedsData[index]) {
                            const rawText = target.innerText;
                            feedsData[index].text = rawText;
                            if (!rawText.trim() && feedsData[index].type === 'text-img') {
                                feedsData[index].type = 'img';
                                saveFeedsData(postId, feedsData);
                                renderFeeds(postId, postId);
                                return;
                            }
                            saveFeedsData(postId, feedsData);
                        }
                        return;
                    }
                }
            }, true);

            const coverInput = document.getElementById('coverInput');
            document.getElementById('triggerCoverUpload').addEventListener('click', () => {
                if(body.classList.contains('edit-mode')) coverInput.click();
            });
            coverInput.addEventListener('change', async function(e) {
                const file = e.target.files[0];
                if (!file) return;
                try {
                    const base64 = await compressImage(file);
                    document.getElementById('profileCover').style.backgroundImage = `url(${base64})`;
                    localStorage.setItem('amber_cover_bg', base64);
                    afterSave();
                } catch (error) {
                    alert('图片处理失败');
                }
            });

            const avatarInput = document.getElementById('avatarInput');
            document.getElementById('triggerAvatarUpload').addEventListener('click', () => {
                if(body.classList.contains('edit-mode')) avatarInput.click();
            });
            avatarInput.addEventListener('change', async function(e) {
                const file = e.target.files[0];
                if (!file) return;
                try {
                    const base64 = await compressImage(file, 300, 300);
                    const mainAvImg = document.getElementById('mainAvatarImg');
                    mainAvImg.src = base64;
                    document.getElementById('mainAvatar').classList.add('has-img');
                    localStorage.setItem('amber_main_avatar', base64);
                    initAllFeeds();  // 头像修改后刷新动态，同步 feed-avatar
                    afterSave();
                } catch (error) {
                    alert('图片处理失败');
                }
            });

            const globalImgInput = document.getElementById('globalImgInput');

            globalImgInput.addEventListener('change', async function(e) {
                const files = e.target.files;
                if (!files || files.length === 0 || !currentUploadTargetId) return;
                if (currentPostIndex === -1) return;

                const postId = currentUploadTargetId;
                let feedsData = getFeedsData(postId);
                if (!feedsData || !feedsData[currentPostIndex]) {
                    this.value = '';
                    return;
                }

                const fileList = Array.from(files);

                if (currentImageIndex === -1) {
                    const currentCount = feedsData[currentPostIndex].img ? feedsData[currentPostIndex].img.length : 0;
                    const remaining = 3 - currentCount;

                    if (remaining <= 0) {
                        alert('单个帖子最多只能上传 3 张图片');
                        this.value = '';
                        return;
                    }

                    if (fileList.length > remaining) {
                        alert(`当前最多还能上传 ${remaining} 张图片，超出部分已忽略。`);
                    }

                    const filesToAdd = fileList.slice(0, remaining);
                    const loadedImages = [];

                    for (let i = 0; i < filesToAdd.length; i++) {
                        try {
                            const base64 = await compressImage(filesToAdd[i]);
                            loadedImages.push(base64);
                        } catch (error) {
                            console.error('压缩失败', error);
                        }
                    }

                    if (loadedImages.length > 0) {
                        feedsData[currentPostIndex].img = (feedsData[currentPostIndex].img || []).concat(loadedImages);
                        saveFeedsData(postId, feedsData);
                        renderFeeds(postId, postId);

                        const newCount = feedsData[currentPostIndex].img.length;
                        if (newCount >= 3) {
                            alert(`已上传满 3 张图片，无法继续上传更多图片。`);
                        } else {
                            alert(`已成功上传 ${loadedImages.length} 张图片，当前共 ${newCount} 张。`);
                        }
                    }
                } else {
                    try {
                        const base64 = await compressImage(files[0]);
                        if (feedsData[currentPostIndex].img && feedsData[currentPostIndex].img[currentImageIndex] !== undefined) {
                            feedsData[currentPostIndex].img[currentImageIndex] = base64;
                            saveFeedsData(postId, feedsData);
                            renderFeeds(postId, postId);
                        }
                    } catch (error) {
                        alert('图片处理失败');
                    }
                }

                this.value = '';
            });

            document.querySelectorAll('.tab').forEach(tab => {
                tab.addEventListener('click', function() {
                    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
                    this.classList.add('active');
                    document.getElementById(this.dataset.tab).classList.add('active');
                });
            });

            document.querySelectorAll('.accordion-header').forEach(header => {
                header.addEventListener('click', function() {
                    this.parentElement.classList.toggle('active');
                });
            });

            // ================= 启动 =================
            (async function init() {
                const isOwner = localStorage.getItem('amber_is_owner') === '1';

                if (!isOwner) {
                    await loadSharedData(true);
                } else {
                    await loadSharedData(false);
                }

                loadSavedData();
                setMode('preview');
            })();
        })();
    </script>
</body>
</html>
